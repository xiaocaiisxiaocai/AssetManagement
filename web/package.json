{
  "name": "asset-management-web",
  "version": "5.5.1",
  "private": true,
  "keywords": [
    "monorepo",
    "turbo",
    "asset-management",
    "internal-admin",
    "vue",
    "vue admin",
    "vue3"
  ],
  "license": "MIT",
  "author": {
    "name": "部门资产管理"
  },
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:antd": "pnpm run build --filter=@vben/web-antd",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "build:docs": "pnpm run build --filter=@vben/docs",
    "build:ele": "pnpm run build --filter=@vben/web-ele",
    "build:naive": "pnpm run build --filter=@vben/web-naive",
    "build:play": "pnpm run build --filter=@vben/playground",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint **/*.ts **/README.md .changeset/*.md --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "turbo-run dev",
    "dev:antd": "pnpm -F @vben/web-antd run dev",
    "dev:docs": "pnpm -F @vben/docs run dev",
    "dev:ele": "pnpm -F @vben/web-ele run dev",
    "dev:naive": "pnpm -F @vben/web-naive run dev",
    "dev:play": "pnpm -F @vben/playground run dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || husky",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/prettier-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/test-utils": "catalog:",
    "autoprefixer": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "husky": "catalog:",
    "is-ci": "catalog:",
    "lint-staged": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "*"
      }
    },
    "overrides": {
      "@ast-grep/napi": "catalog:",
      "@babel/core": ">=7.29.6",
      "@babel/helpers": ">=7.26.10",
      "@babel/runtime": ">=7.26.10",
      "@ctrl/tinycolor": "catalog:",
      "@eslint/config-array>minimatch": "10.2.3",
      "@eslint/eslintrc>minimatch": "10.2.3",
      "@eslint/plugin-kit": ">=0.3.4",
      "@microsoft/api-extractor>minimatch": "3.1.4",
      "@tootallnate/once": ">=2.0.1",
      "ajv@>=7.0.0": ">=8.18.0",
      "ajv@^6.0.0": "6.12.6",
      "brace-expansion@^1.0.0": ">=1.1.13",
      "brace-expansion@^2.0.0": ">=2.0.3",
      "caniuse-lite": "^1.0.30001799",
      "clsx": "catalog:",
      "defu@6.1.4": "6.1.5",
      "editorconfig>minimatch": "9.0.7",
      "esbuild": "0.25.12",
      "eslint>minimatch": "10.2.3",
      "fast-uri": ">=3.1.2",
      "flatted": ">=3.4.2",
      "follow-redirects": ">=1.16.0",
      "form-data": ">=4.0.6",
      "immutable": ">=4.3.8",
      "ip-address": ">=10.1.1",
      "js-cookie": ">=3.0.7",
      "js-yaml@^4.0.0": "4.3.0",
      "jws": ">=3.2.3",
      "lodash": ">=4.18.0",
      "lodash-es": ">=4.18.0",
      "micromatch>picomatch": "4.0.5",
      "node-forge": ">=1.4.0",
      "picomatch@^2.0.0": ">=2.3.2",
      "pinia": "catalog:",
      "postcss@8.4.49": "8.5.16",
      "read-yaml-file>js-yaml": "4.3.0",
      "rimraf>glob": "11.1.0",
      "serialize-javascript": ">=7.0.5",
      "sucrase>glob": "11.1.0",
      "svgo@^3.0.0": ">=3.3.3",
      "tar@6.2.1": "7.5.19",
      "tar@^7.0.0": "7.5.19",
      "tmp": ">=0.2.6",
      "unbuild>rollup": "4.62.2",
      "undici@^6.0.0": ">=6.27.0",
      "vue": "catalog:",
      "yaml@2.7.0": "2.8.3",
      "yaml@^1.0.0": ">=1.10.3",
      "yaml@^2.0.0": ">=2.8.3",
      "zx@^8.0.0": ">=8.8.5"
    },
    "neverBuiltDependencies": [
      "canvas",
      "node-gyp"
    ]
  }
}
