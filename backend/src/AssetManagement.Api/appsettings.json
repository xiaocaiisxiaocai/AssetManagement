{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Attachment": {
    "Path": "App_Data/uploads"
  },
  "DatabaseBackup": {
    "Path": "Backups",
    "RetentionDays": 30,
    "MysqldumpPath": "mysqldump"
  },
  "Jwt": {
    "Issuer": "AssetManagement",
    "ExpireMinutes": 120
  },
  "Security": {
    "EnforcePasswordChange": true,
    "LoginRateLimitEnabled": true
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
